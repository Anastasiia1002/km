VITE_LEAD_API_URL=https://nonastronomically-tasteful-booker.ngrok-free.dev/api/lead
# Absolute URL of the Online-кабінет portal page.
VITE_SUPPORT_API_URL=https://km-trade.net/client-nexus-portal/
