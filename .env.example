# Frontend (Vite) — only VITE_* vars are exposed to the browser build.
VITE_BASE=/km/
# Absolute URL of the lead API (production).
# Locally you can override to /api/lead to use Vite middleware.
VITE_LEAD_API_URL=https://km-trade.net/api/lead
# Absolute URL of the Online-кабінет support submit endpoint.
VITE_SUPPORT_API_URL=https://km-trade.net/client-nexus-portal/process.php
