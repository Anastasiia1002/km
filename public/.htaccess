# SPA fallback for Apache (myVESTA / VestaCP).
# Keeps real files and folders (assets, api, client-nexus-portal, …).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Existing files and directories are served as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else → React app.
  RewriteRule ^ index.html [L]
</IfModule>

# Optional: cache hashed Vite assets aggressively.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|png|jpe?g|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(index\.html|404\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
